@page "/register"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Mail
@using API.Server.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg p-4 rounded-3">
                <div class="card-body text-end">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-plus-fill text-primary display-3"></i>
                        <h2 class="fw-bold mt-2">הרשמה לעובד/ת חדש/ה</h2>
                        <p class="text-muted">מלאי את הפרטים ליצירת חשבון במערכת ShiftMaster</p>
                    </div>

                    <Field Id="reg-username" Label="שם משתמש" @bind-Value="username" />
                    <Field Id="reg-email" Label="אימייל" Type="email" @bind-Value="email" />
                    <Field Id="reg-password" Label="סיסמה" Type="password" @bind-Value="password" />
                    <Field Id="reg-confirm" Label="אימות סיסמה" Type="password" @bind-Value="confirmPassword" />

                    @if (errorMessage != null)
                    {
                        <div class="alert alert-danger" role="alert">@errorMessage</div>
                    }

                    @if (isRegistered)
                    {
                        <div class="alert alert-success" role="status">
                            <strong>ההרשמה הצליחה!</strong> עוברים לדף הכניסה בעוד @secondsLeft שניות.
                        </div>
                    }

                    <button class="btn btn-primary btn-lg w-100 mt-2 shadow-sm mb-3" type="button" 
                            disabled="@(isBusy || isRegistered)" @onclick="RegisterAsync">
                        @(isBusy ? "בודקים..." : "הרשמה")
                    </button>

                    <div class="text-center mt-3">
                        <span class="text-muted">כבר יש לך חשבון?</span>
                        <a href="/login" class="text-primary text-decoration-none fw-bold ms-1">להתחברות</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string email = "";
    private string password = "";
    private string confirmPassword = "";

    private string? errorMessage;
    private bool isBusy = false;
    private bool isRegistered = false;
    private int secondsLeft = 5;

    private async Task RegisterAsync()
    {
        errorMessage = null;

        // בדיקות קלט מקומיות ב-C#
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "יש למלא את כל השדות.";
            return;
        }

        if (!MailAddress.TryCreate(email.Trim(), out _))
        {
            errorMessage = "כתובת האימייל לא תקינה.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "הסיסמה ואימות הסיסמה לא זהים.";
            return;
        }

        isBusy = true;

        try
        {
            // יצירת אובייקט המשתמש מתוך הנתונים שהוקלדו
            DAL.User newUser = new DAL.User
            {
                Username = username.Trim(),
                Email = email.Trim(),
                PasswordHash = password
            };

            // שליחת בקשת POST לשרת בכתובת המדויקת api/user
            HttpResponseMessage response = await Http.PostAsJsonAsync("api/user", newUser);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "ההרשמה נכשלה. נסו שוב.";
                return;
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"שגיאת תקשורת: {ex.Message}";
            return;
        }
        finally
        {
            isBusy = false;
        }

        // הצלחה: ספירה לאחור ומעבר לדף הכניסה
        isRegistered = true;
        while (secondsLeft > 0)
        {
            StateHasChanged();
            await Task.Delay(1000);
            secondsLeft--;
        }
        Navigation.NavigateTo("login");
    }
}